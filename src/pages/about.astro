---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TimelineList from '../components/TimelineList.astro';
import { siteConfig } from '../data/site';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhamad Fikri',
  url: siteConfig.siteUrl,
  email: `mailto:${siteConfig.email}`,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Bandung Institute of Technology (ITB)'
  },
  sameAs: [
    'https://github.com/realmfikri',
    'https://www.linkedin.com/in/muhamad-f-10166a132/',
    'https://x.com/realmfikri'
  ]
};

const timelineItems = [
  {
    period: 'June 2026',
    title: 'Applied AI with AIN Hire',
    description:
      'Built a mobile-first voice-screening prototype with deterministic interview control, separate AI scoring, evidence trails, and required human sign-off.'
  },
  {
    period: 'February 2026',
    title: 'Security and Platform Operations',
    description:
      'Extended eMRTD smartcard work and built a RHEL-style operations lab around Ansible, Podman, systemd, firewalld, and repeatable runbooks.'
  },
  {
    period: '2025',
    title: 'Backend Systems for Real Operators',
    description:
      'Shipped projects across IoT monitoring, retail operations, search, and collaborative systems with an emphasis on useful workflows and maintainable architecture.'
  },
  {
    period: 'ITB',
    title: 'Electrical Engineering Foundation',
    description:
      'Studying software, embedded systems, and systems analysis in a setting that keeps my engineering approach close to physical constraints and real-world impact.'
  }
];
---

<BaseLayout
  path="/about"
  title="About"
  description="About Muhamad Fikri, an ITB electrical engineering student building applied AI products, backend systems, infrastructure, security tools, and IoT systems."
  jsonLd={personJsonLd}
>
  <section class="card p-8 sm:p-10">
    <SectionHeading
      eyebrow="About"
      title="I Like the Whole System"
      description="Model behavior, data contracts, deployment, and the human workflow all shape whether a product actually works."
    />

    <div class="prose-content max-w-4xl">
      <p>
        I am Muhamad Fikri, an Electrical Engineering student at ITB building at the intersection of applied AI, backend
        systems, infrastructure, and security. I tend to work from first principles: understand the constraints, model the
        system clearly, then ship something that can be operated and improved.
      </p>
      <p>
        My recent work adds AI product engineering to that foundation. In AIN Hire, I treated the model as one component in a
        controlled workflow: the interview is bounded by a deterministic state machine, scoring is separated from conversation,
        evidence is retained for review, and a recruiter remains responsible for the final decision. That is the kind of AI system
        I find compelling—useful, inspectable, and designed around human accountability.
      </p>
      <p>
        A recurring theme in my other projects is bridging software and real-world systems: eMRTD and smartcard security,
        sensor-to-dashboard IoT pipelines, and practical platform work with Linux, Ansible, Podman, Nginx, health checks, and
        runbooks. I prefer architectures that are understandable, testable, and maintainable after the demo ends.
      </p>
      <p>
        I also enjoy turning rough ideas into structured scopes: clear requirements, realistic milestones, measurable tradeoffs,
        and interfaces that work for non-technical users. Long-term, I am especially interested in energy and data-center adjacent
        work where software, infrastructure, and physical systems have direct impact.
      </p>
    </div>
  </section>

  <section class="mt-14">
    <SectionHeading
      eyebrow="Timeline"
      title="Recent Direction"
      description="How the work has expanded from backend and connected systems into applied AI and platform operations."
    />
    <div class="card p-6">
      <TimelineList items={timelineItems} />
    </div>
  </section>
</BaseLayout>
